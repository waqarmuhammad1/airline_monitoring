# Browser profile directory (persistent login state)
USER_DATA_DIR=./profile

# United search URL
UNITED_URL=https://www.united.com/en/us/fsr/choose-flights?f=SFO&t=NRT&d=2026-04-10&r=2026-04-12&sc=7%2C7&px=1&taxng=1&newHP=True&clm=7&st=bestmatches&tqp=R

# Output directory
OUTPUT_DIR=./output

# Navigation timeout in ms
NAV_TIMEOUT=60000

# Max retries for click operations
MAX_RETRIES=3

# Retry backoff base in ms
RETRY_BACKOFF_MS=1000

# Max response body size to capture (bytes)
MAX_BODY_SIZE=2097152

# Headless mode (set to true for headless, false for visible browser)
HEADLESS=false
